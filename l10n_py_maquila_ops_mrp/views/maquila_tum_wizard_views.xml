<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_maquila_tum_wizard_form" model="ir.ui.view">
        <field name="name">l10n_py.maquila.tum.wizard.form.mrp</field>
        <field name="model">l10n_py.maquila.tum.wizard</field>
        <field
            name="inherit_id"
            ref="l10n_py_maquila_ops.view_maquila_tum_wizard_form"
        />
        <field name="arch" type="xml">
            <field name="van_amount" position="after">
                <field name="total_cost" />
                <field name="national_cost" />
                <field name="mercosul_cost" />
                <field name="imported_cost" />
            </field>
            <xpath expr="//field[@name='van_amount']/ancestor::group[2]" position="before">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not van_warning"
                >
                    <field name="van_warning" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>

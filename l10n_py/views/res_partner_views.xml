<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extensión de la vista de formulario de partners -->
    <record id="view_partner_form_py" model="ir.ui.view">
        <field name="name">res.partner.form.py</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Agregar campo RUC después del VAT -->
            <xpath expr="//field[@name='vat']" position="after">
                <field name="ruc" placeholder="ej: 12345678-9"/>
                <field name="taxpayer_type"/>
            </xpath>

        </field>
    </record>

    <!-- Extensión de la vista de lista de partners -->
    <record id="view_partner_tree_py" model="ir.ui.view">
        <field name="name">res.partner.tree.py</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">

            <!-- Agregar columna de RUC -->
            <xpath expr="//field[@name='vat']" position="after">
                <field name="ruc" optional="show"/>
            </xpath>

        </field>
    </record>

    <!-- Extensión de la vista de búsqueda de partners -->
    <record id="view_res_partner_filter_py" model="ir.ui.view">
        <field name="name">res.partner.search.py</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">

            <!-- Agregar búsqueda por RUC -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="ruc" string="RUC"/>
            </xpath>

            <!-- Agregar filtro por tipo de contribuyente -->
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="Persona Física" name="natural" domain="[('taxpayer_type', '=', 'natural')]"/>
                <filter string="Persona Jurídica" name="juridica" domain="[('taxpayer_type', '=', 'juridica')]"/>
                <filter string="Extranjero" name="foreign" domain="[('taxpayer_type', '=', 'foreign')]"/>
            </xpath>

        </field>
    </record>

</odoo>

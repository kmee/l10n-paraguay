<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="kude_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row">
                            <div class="col-12">
                                <h2 class="text-center">REPRESENTACIÓN IMPRESA</h2>
                                <h3 class="text-center">KUDE - Kua'i'ú Derecho Electrónico</h3>
                            </div>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>CDC:</strong> <span t-field="doc.l10n_py_cdc"/>
                            </div>
                            <div class="col-6">
                                <strong>Fecha:</strong> <span t-field="doc.invoice_date"/>
                            </div>
                        </div>
                        
                        <div class="row mt-2">
                            <div class="col-12">
                                <strong>Cliente:</strong> <span t-field="doc.partner_id.name"/>
                            </div>
                        </div>
                        
                        <div class="row mt-2">
                            <div class="col-12">
                                <strong>RUC:</strong> <span t-field="doc.partner_id.l10n_py_ruc_full"/>
                            </div>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-12">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Descripción</th>
                                            <th>Cantidad</th>
                                            <th>Precio Unit.</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.invoice_line_ids" t-as="line">
                                            <tr>
                                                <td><span t-field="line.name"/></td>
                                                <td><span t-field="line.quantity"/></td>
                                                <td><span t-field="line.price_unit"/></td>
                                                <td><span t-field="line.price_subtotal"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-12 text-right">
                                <strong>Total:</strong> <span t-field="doc.amount_total"/>
                            </div>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-12 text-center">
                                <p t-if="doc.l10n_py_qr_string">
                                    <img t-att-src="'data:image/png;base64,' + doc.l10n_py_qr_string"/>
                                </p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

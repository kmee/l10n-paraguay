<odoo>

    <record id="base.py" model="res.country">

        <field name="enforce_cities">1</field>
        <field name="name_position">before</field>
        <field
            name="address_format"
            eval="'%(street)s %(street2)s\n%(zip)s - %(city)s - %(state_name)s\n%(country_name)s'"
        />
        <field name="vat_label">RUC</field>
    </record>

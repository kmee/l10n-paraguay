<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.l10n_py_maquila_inter_company</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="tax_cash_basis_origin_move_id" position="after">
                <field
                    name="l10n_py_source_document_number"
                    invisible="not l10n_py_source_document_number"
                />
                <field name="l10n_py_source_cdc" invisible="not l10n_py_source_cdc" />
            </field>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                position="after"
            >
                <field
                    name="l10n_py_source_ncm_code"
                    optional="show"
                    column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"
                />
            </xpath>
        </field>
    </record>
</odoo>

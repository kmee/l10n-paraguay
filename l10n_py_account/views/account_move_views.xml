<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Extensión de la vista de formulario de facturas -->
    <record id="view_move_form_py" model="ir.ui.view">
        <field name="name">account.move.form.py</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <!-- Agregar campos de timbrado después del campo de journal -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <field
                    name="authorization_id"
                    invisible="move_type not in ['out_invoice', 'out_refund']"
                    required="move_type in ['out_invoice', 'out_refund'] and state == 'posted'"
                />
                <field
                    name="full_invoice_number"
                    invisible="move_type not in ['out_invoice', 'out_refund'] or not authorization_id"
                    readonly="1"
                />
            </xpath>

            <!-- Agregar notebook con información fiscal paraguaya -->
            <xpath expr="//notebook" position="inside">
                <page
                    string="Información Fiscal Paraguay"
                    name="l10n_py_fiscal"
                    invisible="move_type not in ['out_invoice', 'out_refund']"
                >
                    <group>
                        <group string="Discriminación de IVA">
                            <field name="amount_subtotal_10" />
                            <field name="amount_iva_10" />
                            <separator />
                            <field name="amount_subtotal_5" />
                            <field name="amount_iva_5" />
                            <separator />
                            <field name="amount_subtotal_exempt" />
                            <separator />
                            <field name="amount_iva_total" style="font-weight: bold;" />
                        </group>
                        <group string="Información del Timbrado">
                            <field
                                name="authorization_id"
                                readonly="state == 'posted'"
                            />
                            <field name="invoice_number" readonly="1" />
                            <field name="full_invoice_number" readonly="1" />
                        </group>
                    </group>
                    <group string="Total en Letras">
                        <field name="amount_total_words" readonly="1" />
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Extensión de la vista de lista de facturas -->
    <record id="view_invoice_tree_py" model="ir.ui.view">
        <field name="name">account.move.tree.py</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">

            <!-- Agregar columna de número completo de factura -->
            <xpath expr="//field[@name='name']" position="after">
                <field
                    name="full_invoice_number"
                    optional="show"
                    string="Nro. Factura"
                />
            </xpath>

            <!-- Agregar columna de timbrado -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="authorization_id" optional="hide" />
            </xpath>

        </field>
    </record>

</odoo>

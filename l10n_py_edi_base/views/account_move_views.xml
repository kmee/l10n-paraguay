<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_edi" model="ir.ui.view">
        <field name="name">account.move.form.edi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <group>
                    <group string="Facturación Electrónica">
                        <field name="l10n_py_edi_document_type" readonly="1"/>
                        <field name="l10n_py_emission_type"/>
                        <field name="l10n_py_transaction_type"/>
                        <field name="l10n_py_presence_type"/>
                        <field name="l10n_py_receipt_id"/>
                        <field name="l10n_py_security_code" readonly="1"/>
                        <field name="l10n_py_contingency_motive"/>
                    </group>
                    <group string="Estado EDI">
                        <field name="l10n_py_edi_status" widget="statusbar" statusbar_visible="draft,to_send,sent,processing,accepted"/>
                        <field name="l10n_py_edi_message" widget="text"/>
                        <field name="l10n_py_cdc" readonly="1"/>
                        <field name="l10n_py_edi_batch_id" readonly="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_send_edi" string="Enviar a EDI" type="object" 
                        class="oe_highlight" 
                        attrs="{'invisible': [('l10n_py_edi_status', 'in', ['sent', 'accepted', 'processing'])]}"/>
                <button name="action_retry_edi" string="Reintentar" type="object"
                        attrs="{'invisible': [('l10n_py_edi_status', 'not in', ['error', 'rejected'])]}"/>
                <button name="action_cancel_edi" string="Cancelar EDI" type="object"
                        attrs="{'invisible': [('l10n_py_cdc', '=', False)]}"/>
                <button name="action_download_xml" string="Descargar XML" type="object"
                        attrs="{'invisible': [('l10n_py_edi_xml', '=', False)]}"/>
                <button name="action_download_kude" string="Descargar KUDE" type="object"
                        attrs="{'invisible': [('l10n_py_kude_pdf', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>

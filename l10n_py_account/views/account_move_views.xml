<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Extensión de la vista de formulario de facturas -->
    <record id="view_move_form_py" model="ir.ui.view">
        <field name="name">account.move.form.py</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    string="Información Fiscal Paraguay"
                    name="l10n_py_fiscal"
                    invisible="move_type not in ['out_invoice', 'out_refund']"
                >
                    <group>
                        <group string="Información del Timbrado">
                            <field name="authorization_id" />
                            <field name="invoice_number" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extensión de la vista de lista de facturas -->
    <record id="view_invoice_tree_py" model="ir.ui.view">
        <field name="name">account.move.tree.py</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">

            <!-- Agregar columna de timbrado -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="authorization_id" optional="hide" />
            </xpath>

        </field>
    </record>

</odoo>

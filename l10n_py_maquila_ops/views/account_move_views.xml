<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_maquila" model="ir.ui.view">
        <field name="name">account.move.form.maquila</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='accounting_info_group']/field[@name='fiscal_position_id']"
                position="after"
            >
                <field
                    name="l10n_py_maquila_program_id"
                    readonly="state != 'draft'"
                    domain="[('company_id', '=', company_id)]"
                />
            </xpath>
            <xpath
                expr="//group[@id='other_tab_entry_group']//field[@name='fiscal_position_id']"
                position="after"
            >
                <field
                    name="l10n_py_maquila_program_id"
                    readonly="state != 'draft'"
                    domain="[('company_id', '=', company_id)]"
                />
            </xpath>
        </field>
    </record>
</odoo>
